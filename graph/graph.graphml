      <data key="e_quote">Christel Heydemann (born 9 October 1974) is a French businesswoman and the chief executive officer (CEO) of the French telecommunications company Orange S.A. since April 2022.</data>
    </edge>
    <edge id="e2546" source="christian-klein" target="sap">
      <data key="e_predicate">employed_by</data>
